load(file = "C:/Users/patricklepage/OneDrive - Cégep de Jonquière/CollabOliPat/CartoJeunes/Scripts/Grande_Bd/grande_bd_2026-06-29.rdata")
load(file = "C:/Users/patricklepage/OneDrive - Cégep de Jonquière/Shiny_Regard/Beta_053/Metadata_29juin2026.rdata")
grande_bd_no_dim_1 <- grande_bd |>
filter(sexe == "total" | is.na(sexe),
reseau == "Tous réseaux confondus" | is.na(reseau),
type_form_nom == "Secteurs d'études réunis" | is.na(type_form_nom)
) |>
select(-dip7_imse8a10,-dip7_imse4a7,-dip7_imse1a3,-dip7_ehdaa,-dip7_ordinaires,-dip7_imm_1re_gen,-dip7_imm_2e_gen,-dip7_non_imm,
-dip7_retard,-dip7_pas_retard,-tx_imse_8_10_sec,-tx_imse_4_7_sec,-tx_imse_1_3_sec)
# Les données pour dip7 sous population sont seulement pour le réseau Public.
grande_bd_no_dim_souspop <- grande_bd |>
filter(sexe == "total" | is.na(sexe),reseau == "Public" | is.na(reseau),
type_form_nom == "Secteurs d'études réunis" | is.na(type_form_nom),
) |>
select(cle_geo_annee,
dip7_imse8a10, dip7_imse4a7, dip7_imse1a3, dip7_ehdaa, dip7_ordinaires, dip7_imm_1re_gen, dip7_imm_2e_gen, dip7_non_imm,
dip7_retard, dip7_pas_retard, tx_imse_8_10_sec, tx_imse_4_7_sec, tx_imse_1_3_sec)
grande_bd_no_dim <- grande_bd_no_dim_1 |>
left_join(grande_bd_no_dim_souspop, by = join_by(cle_geo_annee))
# Liste des indicateurs de l'onglet parcours scolaire
ind_sco <- metadata |>
filter(onglet_sco %in% c("oui","oui_public_seulement"))
list_ind_parsco <- ind_sco$indicateurs
grande_bd_parsco <- grande_bd |>
filter(type_form_nom == "Secteurs d'études réunis" | is.na(type_form_nom),
#sexe_coll == "Sexes réunis" | is.na(sexe_coll)
) |>
select(cle_geo_annee,code_geo,annee,decoupage,nom,ra_app_nom,sexe,reseau,
all_of(list_ind_parsco)) |>
mutate(sexe = as.character(sexe)) |>
mutate(reseau = as.character(reseau)) |>
mutate(sexe = case_when(
sexe ==  "total" ~ "Sexes réunis",
sexe ==  "masculin" ~ "Garçons",
sexe ==  "feminin" ~ "Filles"
))
save(grande_bd_parsco, file = "C:/Users/patricklepage/OneDrive - Cégep de Jonquière/Shiny_Regard/Beta_053/grande_bd_parsco_29juin2026.rdata")
bd_ann_recente_1 <- grande_bd_no_dim |>
select(-sexe,-reseau,-type_form_nom) |>
#pivot_longer(cols = -c(cle_geo_annee,annee,code_geo,nom,ra_app_code,ra_app_nom,decoupage,code_ra,code_mrc),names_to = "indicateurs",values_to = "valeur") |>
pivot_longer(cols = -c(cle_geo_annee,annee,code_geo,nom,sante,ra_app_code,ra_app_nom,rss_app_code,mrc_app_code,rls_app_code,mun_app_code,decoupage,code_ra,
code_rss,code_dr,code_mrc,code_rls,code_mun,code_autre_decoupage,tno,hors_mrc,autochtone,commentaire_mise_a_jour,terr_equi,code_shp,mrc_app_nom,statut_geo),names_to = "indicateurs",values_to = "valeur")
bd_ann_recente <- bd_ann_recente_1 |>
left_join(metadata) |>
filter(annee == annee_recente)
save(bd_ann_recente, file = "C:/Users/patricklepage/OneDrive - Cégep de Jonquière/Shiny_Regard/Beta_053/bd_ann_recente_29juin2026.rdata")
col_round_1 <- grande_bd_no_dim |> select(-gini_revtot_menage,-gini_revtot_apres_menage,
-dep_adm_culture_par_hab,-dep_mun_culture_par_hab,-rev_billet_par_hab,-billet_tot_par_hab,
-nb_prets_par_hab,-nb_livres_par_hab)
col_round_2 <- grande_bd_no_dim |> select(dep_adm_culture_par_hab,dep_mun_culture_par_hab,rev_billet_par_hab,billet_tot_par_hab,nb_prets_par_hab,
nb_livres_par_hab)
col_round_3 <- grande_bd_no_dim |> select(gini_revtot_menage,gini_revtot_apres_menage)
name_round_1 <- colnames(col_round_1[,sapply(col_round_1,is.numeric)])
name_round_2 <- colnames(col_round_2[,sapply(col_round_2,is.numeric)])
name_round_3 <- colnames(col_round_3[,sapply(col_round_3,is.numeric)])
grande_bd_no_dim_all_digits <- grande_bd_no_dim |>
mutate_if(is.numeric,
round,
digits = 4) |>
mutate(code_geo = as.numeric(code_geo)) |>
relocate(annee)
grande_bd_no_dim <- grande_bd_no_dim %>%
mutate_if(
names(.) %in% name_round_1,
round,
digits = 1
)
grande_bd_no_dim <- grande_bd_no_dim %>%
mutate_if(
names(.) %in% name_round_3,
round,
digits = 3
)
grande_bd_no_dim <- grande_bd_no_dim %>%
mutate_if(
names(.) %in% name_round_2,
round,
digits = 2
)
grande_bd_no_dim <- grande_bd_no_dim %>%
mutate(
color_ecobes = case_when(
decoupage == "ra" ~ "#6DA3ED",
decoupage == "prov" ~ "#4774BA",
decoupage == "rss" ~ "#B082C1",
TRUE ~ "#99DBE5"
)) |>
mutate(code_geo = as.numeric(code_geo)) |>
relocate(annee)
save(grande_bd_no_dim, file = "C:/Users/patricklepage/OneDrive - Cégep de Jonquière/Shiny_Regard/Beta_053/grande_bd_no_dim_29juin2026.rdata")
save(grande_bd_no_dim_all_digits, file = "C:/Users/patricklepage/OneDrive - Cégep de Jonquière/Shiny_Regard/Beta_053/grande_bd_no_dim_all_digits_29juin2026.rdata")
save(name_round_1, file = "C:/Users/patricklepage/OneDrive - Cégep de Jonquière/Shiny_Regard/Beta_053/name_round_1.rdata")
save(name_round_2, file = "C:/Users/patricklepage/OneDrive - Cégep de Jonquière/Shiny_Regard/Beta_053/name_round_2.rdata")
save(name_round_3, file = "C:/Users/patricklepage/OneDrive - Cégep de Jonquière/Shiny_Regard/Beta_053/name_round_3.rdata")
runApp('Beta_053.R')
